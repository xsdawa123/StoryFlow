package handler

import (
"story2video_server/config"
"story2video_server/model"
"story2video_server/utils"
"github.com/gin-gonic/gin"
"go.uber.org/zap"
"net/http"
)

// StoryCallbackReq 分镜回调请求参数结构体
type StoryCallbackReq struct {
TaskID        string `json:"task_id" binding:"required"`
Status        string `json:"status" binding:"required"`
ProjectID     string `json:"project_id"`
RawStory      string `json:"raw_story"`
Style         string `json:"style"`
ProjectStatus string `json:"project_status"`
}

// StoryCallback 分镜回调处理函数（含完整写入逻辑+日志）
func StoryCallback(c *gin.Context) {
// 1. 绑定并校验参数
var req StoryCallbackReq
if err := c.ShouldBindJSON(&req); err != nil {
utils.Logger.Error("分镜回调-参数绑定失败", zap.Error(err))
c.JSON(http.StatusBadRequest, gin.H{
"code": 400,
"data": nil,
"msg":  "参数错误: " + err.Error(),
})
return
}

// 2. 打印接收的核心参数（必看！确认参数正确）
utils.Logger.Info("分镜回调-接收参数",
zap.String("task_id", req.TaskID),
zap.String("project_id", req.ProjectID),
zap.String("raw_story", req.RawStory),
zap.String("style", req.Style),
zap.String("project_status", req.ProjectStatus),
)

// 3. 组装Project模型（匹配数据库表结构）
project := model.Project{
ProjectID:     req.ProjectID,
RawStory:      req.RawStory,
Style:         req.Style,
ProjectStatus: req.ProjectStatus,
}

// 4. 写入数据库 + 完整日志
utils.Logger.Info("分镜回调-开始写入projects表", zap.String("project_id", req.ProjectID))
if err := config.DB.Create(&project).Error; err != nil {
utils.Logger.Error("分镜回调-写入数据库失败",
zap.String("project_id", req.ProjectID),
zap.Error(err),
)
c.JSON(http.StatusInternalServerError, gin.H{
"code": 500,
"data": nil,
"msg":  "写入数据库失败：" + err.Error(),
})
return
}

// 5. 写入成功日志
utils.Logger.Info("分镜回调-写入数据库成功", zap.String("project_id", req.ProjectID))

// 6. 返回成功响应
c.JSON(http.StatusOK, gin.H{
"code": 0,
"data": gin.H{"task_id": req.TaskID},
"msg":  "分镜回调接收成功",
})
}

// 其他回调函数（保留，避免编译错误）
func ImageCallback(c *gin.Context) {
c.JSON(http.StatusOK, gin.H{
"code": 0,
"msg":  "图片回调接收成功",
})
}

func VideoCallback(c *gin.Context) {
c.JSON(http.StatusOK, gin.H{
"code": 0,
"msg":  "视频回调接收成功",
})
}
