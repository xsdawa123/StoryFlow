package main

import (
"story2video_server/handler"
"story2video_server/utils" 
"github.com/gin-gonic/gin"
)

func main() {
// 创建Gin引擎
r := gin.Default()

// 注册API路由组（直接映射AI Server路径，无/client层级）
api := r.Group("/api")
{
// 直接绑定AI Server风格路径到处理函数
api.POST("/generate/story", handler.GenerateStory)
api.POST("/generate/images", handler.GenerateImages)
api.POST("/generate/audios", handler.GenerateAudios)

// 分镜/项目列表查询（保留原有路径，按需调整）
api.GET("/shots/list", handler.ListShots)
api.GET("/projects/list", handler.ListProjects)

// AI Server回调路由组
callback := api.Group("/callback")
{
callback.POST("/story/result", handler.StoryResultCallback)
callback.POST("/image/result", handler.ImageResultCallback)
callback.POST("/audio/result", handler.AudioResultCallback)
}
}

// 启动服务，监听8080端口
err := r.Run(":8080")
if err != nil {
panic("服务启动失败: " + err.Error())
}
}
